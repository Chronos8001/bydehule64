# Port d'écoute (Render/Railway le fournissent automatiquement)
PORT=3001

# Emplacement du fichier SQLite
DATABASE_FILE=./data/scores.db

# Origines autorisées par CORS, séparées par des virgules.
# Vide = toutes les origines (pratique en développement).
ALLOWED_ORIGINS=http://localhost:5173

# Jeton requis pour DELETE /api/scores/:id
ADMIN_TOKEN=changez-moi

# Mettre à false pour désactiver ?__delay et ?__fail
CHAOS_ENABLED=true
