{
    "name": "scoreboard-api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "API de scores et de temps de jeu (Express + TypeScript + SQLite)",
    "engines": {
        "node": ">=22.5.0"
    },
    "scripts": {
        "dev": "tsx watch --no-warnings src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node --no-warnings dist/index.js",
        "seed": "tsx --no-warnings src/seed.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "express": "^4.21.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^22.7.5",
        "tsx": "^4.19.1",
        "typescript": "^5.6.3"
    }
}